---
const links = [
  ['Resumen', '#top'],
  ['Comanda', '#comanda'],
  ['Cocina', '#cocina'],
  ['Cajones', '#cajones'],
  ['Hardware', '#hardware'],
];
---

<div class="globalnav wrap-wide flex h-11 items-center justify-between text-[12px] text-[#d2d2d7]">
  <a href="/" class="flex items-center gap-2" aria-label="SERVIHOST, inicio">
    <img src="/logo-mark.png" alt="" width="26" height="23" class="h-[22px] w-auto" />
    <span class="font-semibold tracking-[0.02em] text-white">SERVIHOST</span>
  </a>
  <span class="hidden sm:inline">Valencia · <a class="hover:text-white" href="tel:+34633748236">633 748 236</a> · <a class="hover:text-white" href="mailto:info@servihostpv.com">info@servihostpv.com</a></span>
</div>

<nav class="localnav sticky top-0 z-50" aria-label="Producto">
  <div class="wrap-wide flex h-[52px] items-center justify-between gap-6">
    <a href="#top" class="text-[19px] font-semibold tracking-[-0.02em] text-white sm:text-[21px]">SERVIHOST TPV</a>
    <div class="flex items-center gap-6">
      <ul class="hidden items-center gap-6 text-[12px] text-[#d2d2d7] md:flex">
        {links.map(([label, href]) => <li><a class="transition-colors hover:text-white" href={href}>{label}</a></li>)}
      </ul>
      <a class="pill !min-h-[28px] !px-3 !text-[12px]" href="#demo">Pedir demo</a>
    </div>
  </div>
</nav>

<style>
  .globalnav { background: #161617; }
  .localnav {
    background: rgba(22, 22, 23, 0.72);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    backdrop-filter: saturate(180%) blur(20px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }
  @media (prefers-reduced-transparency: reduce) {
    .localnav { background: #161617; -webkit-backdrop-filter: none; backdrop-filter: none; }
  }
</style>
