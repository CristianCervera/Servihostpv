---
const steps = [
  { title: 'En la mesa.', text: 'El camarero marca la comanda en la comandera Android y cobra con tarjeta sin moverse.' },
  { title: 'En cocina.', text: 'Los platos aparecen en el monitor de cocina con su tiempo. Sin papeles, sin gritos.' },
  { title: 'En la barra.', text: 'Las bebidas salen impresas en la barra al instante. Nada se queda por el camino.' },
  { title: 'En tu móvil.', text: 'La venta suma en el back office en tiempo real, estés donde estés.' },
];
---

<section id="comanda" class="story relative mt-[clamp(100px,12vw,180px)]" aria-labelledby="story-title">
  <div class="wrap text-center">
    <h2 id="story-title" class="text-title" data-rise>Una comanda.<br />Tres destinos.</h2>
    <p class="mx-auto mt-6 max-w-[40ch] text-lead text-grey" data-rise style="--i:1">
      Así viaja un pedido por tu local cuando todo está conectado.
    </p>
  </div>

  <div class="story-stage wrap-wide mt-12 md:mt-0" data-story>
    <ol class="story-steps">
      {steps.map((s, i) => (
        <li class="story-step" data-step={i}>
          <h3 class="text-sub">{s.title}</h3>
          <p class="mt-3 max-w-[34ch] text-lead">{s.text}</p>
        </li>
      ))}
    </ol>

    <div class="story-visual" aria-hidden="true">
      <!-- 1. Comandera -->
      <div class="panel" data-panel="0">
        <div class="hand">
          <div class="hand-screen">
            <div class="flex justify-between bg-[#111] px-4 py-3 text-[13px] text-white"><span class="font-semibold">Terraza · Mesa 4</span><span>13:42</span></div>
            <div class="space-y-2 p-3 text-[14px] text-[#111]">
              <div class="row">1 × Clóchinas<span>9,00 €</span></div>
              <div class="row">1 × Esgarraet<span>7,50 €</span></div>
              <div class="row">1 × Paella valenciana<span>14,00 €</span></div>
              <div class="row">1 × Agua de Valencia<span>14,00 €</span></div>
              <div class="send-btn">Enviar a cocina y barra</div>
            </div>
          </div>
        </div>
      </div>
      <!-- 2. Cocina -->
      <div class="panel" data-panel="1">
        <div class="kds">
          <div class="flex justify-between px-4 py-3 text-[13px] text-[#a1a1a6]"><span class="font-semibold text-white">Cocina</span><span>3 pedidos</span></div>
          <div class="grid grid-cols-3 gap-2 p-2">
            <div class="kcard"><div class="khead bg-[#ff9f0a]">#25 · 07:12</div><div class="kbody">2 Bravas<br />1 Sepia</div></div>
            <div class="kcard"><div class="khead bg-[#34c759]">#26 · 03:40</div><div class="kbody">1 Titaina<br />1 Calamar</div></div>
            <div class="kcard knew"><div class="khead bg-[#0a84ff]">#27 · 00:00</div><div class="kbody">1 Clóchinas<br />1 Esgarraet<br />1 Paella</div></div>
          </div>
        </div>
      </div>
      <!-- 3. Barra -->
      <div class="panel" data-panel="2">
        <div class="printer2">
          <div class="ticket2">
            <div class="flex justify-between font-semibold"><span>Barra</span><span>#27</span></div>
            <div class="text-[#6e6e73]">Terraza · Mesa 4 · 13:42</div>
            <div class="mt-3">1 × Agua de Valencia</div>
          </div>
          <div class="pbody"></div>
        </div>
      </div>
      <!-- 4. Back office -->
      <div class="panel" data-panel="3">
        <div class="bo">
          <div class="text-[15px] text-[#a1a1a6]">Ventas de hoy · 3 locales</div>
          <div class="bo-n tabular-nums" data-bo>2.388,10 €</div>
          <div class="bo-bars">
            {[38, 52, 44, 61, 70, 58, 82, 95, 66, 74, 88].map((h) => <span style={`height:${h}%`}></span>)}
            <span class="bo-last" style="height:100%"></span>
          </div>
          <div class="mt-4 flex justify-between text-[14px] text-[#a1a1a6]"><span>Mesa 4 · Terraza</span><span class="text-[#30d158]">+ 44,50 €</span></div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .story-stage { display: grid; gap: 40px; }
  .story-steps { display: flex; flex-direction: column; gap: 48px; }
  .story-step { color: #f5f5f7; }
  .story-step p { color: var(--color-grey); }
  .story-visual { display: none; }

  @media (min-width: 900px) {
    .story-stage { grid-template-columns: 0.9fr 1.1fr; align-items: center; height: 100svh; padding-top: 52px; }
    .story-steps { gap: 36px; }
    .story-step { color: #7c7c80; transition: color 400ms ease; }
    .story-step p { color: #7c7c80; transition: color 400ms ease; }
    .story-step.is-on { color: #f5f5f7; }
    .story-step.is-on p { color: #a1a1a6; }
    .story-visual { display: block; position: relative; height: min(640px, 76svh); }
  }

  .panel { position: absolute; inset: 0; display: grid; place-items: center; opacity: 0; }
  .panel[data-panel='0'] { opacity: 1; }

  .hand { width: 300px; padding: 10px; border-radius: 44px; background: #0d0d0e; box-shadow: inset 0 0 0 1px #3a3a3c; }
  .hand-screen { border-radius: 34px; overflow: hidden; background: #eef0f3; min-height: 520px; }
  .row { display: flex; justify-content: space-between; border-radius: 12px; background: #fff; padding: 12px; }
  .send-btn { margin-top: 14px; border-radius: 12px; background: #d92b21; color: #fff; text-align: center; padding: 14px; font-weight: 600; }

  .kds { width: min(600px, 100%); border-radius: 22px; background: #111113; padding: 6px; box-shadow: inset 0 0 0 1px #2c2c2e; }
  .kcard { border-radius: 12px; overflow: hidden; background: #1d1d1f; color: #f5f5f7; font-size: 15px; }
  .khead { padding: 8px 10px; color: #111; font-weight: 700; }
  .kbody { padding: 10px; line-height: 1.5; min-height: 110px; }

  .printer2 { display: flex; flex-direction: column; align-items: center; }
  .ticket2 {
    width: 260px; background: #fff; color: #111; padding: 18px 18px 30px; font-size: 16px; line-height: 1.5;
    clip-path: polygon(0 0,100% 0,100% calc(100% - 10px),95% 100%,90% calc(100% - 10px),85% 100%,80% calc(100% - 10px),75% 100%,70% calc(100% - 10px),65% 100%,60% calc(100% - 10px),55% 100%,50% calc(100% - 10px),45% 100%,40% calc(100% - 10px),35% 100%,30% calc(100% - 10px),25% 100%,20% calc(100% - 10px),15% 100%,10% calc(100% - 10px),5% 100%,0 calc(100% - 10px));
  }
  .pbody { width: 340px; height: 130px; border-radius: 22px 22px 12px 12px; background: #2c2c2e; box-shadow: inset 0 1px 0 #48484a; margin-top: -4px; }

  .bo { width: min(520px, 100%); border-radius: 28px; background: #1d1d1f; padding: 36px; }
  .bo-n { font-size: clamp(3rem, 5.6vw, 5rem); font-weight: 600; letter-spacing: -0.045em; line-height: 1.05; margin-top: 4px; }
  .bo-bars { display: flex; align-items: flex-end; gap: 8px; height: 150px; margin-top: 26px; }
  .bo-bars span { flex: 1; border-radius: 6px 6px 2px 2px; background: #3a3a3c; }
  .bo-bars .bo-last { background: #ff5a4f; transform-origin: bottom; }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const stage = document.querySelector<HTMLElement>('[data-story]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (stage) {
    const steps = [...stage.querySelectorAll<HTMLElement>('.story-step')];
    const panels = [...stage.querySelectorAll<HTMLElement>('.panel')];
    const bo = stage.querySelector<HTMLElement>('[data-bo]')!;
    const fmt = (n: number) => new Intl.NumberFormat('es-ES', { minimumFractionDigits: 2, maximumFractionDigits: 2, useGrouping: 'always' } as Intl.NumberFormatOptions).format(n) + ' €';
    const setStep = (i: number) => steps.forEach((s, k) => s.classList.toggle('is-on', k === i));
    setStep(0);

    const mm = gsap.matchMedia();
    mm.add('(min-width: 900px)', () => {
      const tl = gsap.timeline({
        defaults: { ease: 'power2.inOut' },
        scrollTrigger: {
          trigger: stage,
          start: 'top top',
          end: '+=300%',
          pin: true,
          scrub: reduce ? false : 0.6,
          onUpdate: (self) => setStep(Math.min(3, Math.floor(self.progress * 4 * 0.999))),
        },
      });
      const count = { v: 2388.1 };
      // 0 → 1: the order leaves the handheld and lands on the kitchen screen.
      tl.to(panels[0], { opacity: 0, scale: 0.9, y: -40, duration: 0.5 }, 0.6)
        .fromTo(panels[1], { opacity: 0, scale: 1.08 }, { opacity: 1, scale: 1, duration: 0.5 }, 0.75)
        .fromTo(panels[1].querySelector('.knew'), { y: 60, opacity: 0 }, { y: 0, opacity: 1, duration: 0.4 }, 0.95)
        // 1 → 2: the bar printer feeds its ticket.
        .to(panels[1], { opacity: 0, scale: 0.92, duration: 0.5 }, 1.6)
        .fromTo(panels[2], { opacity: 0 }, { opacity: 1, duration: 0.3 }, 1.75)
        .fromTo(panels[2].querySelector('.ticket2'), { y: 180, clipPath: 'inset(0 0 100% 0)' }, { y: 0, clipPath: 'inset(0 0 0% 0)', ease: 'steps(18)', duration: 0.7 }, 1.85)
        // 2 → 3: the sale lands in the back office.
        .to(panels[2], { opacity: 0, y: -30, duration: 0.5 }, 2.6)
        .fromTo(panels[3], { opacity: 0, scale: 1.06 }, { opacity: 1, scale: 1, duration: 0.5 }, 2.75)
        .fromTo(panels[3].querySelector('.bo-last'), { scaleY: 0.1 }, { scaleY: 1, duration: 0.5 }, 2.95)
        .to(count, { v: 2432.6, duration: 0.6, ease: 'power1.out', onUpdate: () => (bo.textContent = fmt(count.v)) }, 2.95)
        .to({}, { duration: 0.45 });
    });
  }
</script>
