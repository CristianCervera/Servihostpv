---
import { Image } from 'astro:assets';
import { zz } from '../../lib/zigzag';
import titan from '../../assets/titan.jpg';
import forza from '../../assets/forza.jpg';
import dibal from '../../assets/dibal.jpg';

const models = [
  {
    id: 'titan',
    tab: 'SAM4S Titan 360',
    img: titan,
    alt: 'Terminal táctil SAM4S Titan 360 en blanco, con pantalla de cliente en la parte trasera',
    text: 'Un terminal elegante con acceso fácil a sus componentes, pensado para el punto de venta más exigente. SAM4S es filial de Samsung y una marca de reconocido prestigio.',
  },
  {
    id: 'forza',
    tab: 'SAM4S Forza',
    img: forza,
    alt: 'Terminal SAM4S Forza con pantalla de cliente e impresora térmica en la misma base',
    text: 'Diseño, innovación y velocidad en el servicio. El equipo para quien quiere darle un toque distinto al mostrador, con impresora térmica triple interfaz a juego.',
  },
  {
    id: 'dibal',
    tab: 'Dibal y Honeywell',
    img: dibal,
    alt: 'Balanzas táctiles Dibal con plato de pesaje y un lector de códigos de barras Honeywell',
    text: 'Balanzas Dibal, expertos en pesaje y etiquetado desde 1985, y lectores de códigos de barras Honeywell para tiendas, fruterías y carnicerías.',
  },
];
---

<section id="hardware" class="mt-[clamp(120px,14vw,200px)] bg-surface" aria-labelledby="hardware-title">
  <div class="frame grid min-h-[88svh] items-center gap-10 py-16 md:grid-cols-2 md:gap-[var(--g)] md:py-20">
    <div class="plate zz relative mx-auto aspect-square w-full max-w-[640px] bg-white" style={zz({ bottom: true, depth: 12, teeth: 28, teethSm: 14 })} data-rise>
      {models.map((m, i) => (
        <Image
          src={m.img}
          alt={m.alt}
          widths={[480, 800]}
          sizes="(min-width: 768px) 45vw, 92vw"
          class="hw-img absolute inset-0 h-full w-full object-contain p-[8%]"
          data-model={m.id}
          loading="lazy"
          style={i === 0 ? '' : 'opacity:0'}
        />
      ))}
    </div>

    <div class="flex flex-col justify-between gap-10 md:min-h-[min(640px,80svh)] md:pl-[6%]">
      <div class="flex flex-wrap gap-x-6 gap-y-2" role="tablist" aria-label="Modelos">
        {models.map((m, i) => (
          <button
            type="button"
            role="tab"
            class="hw-tab min-h-[44px] text-[1.0625rem] md:text-[1.125rem]"
            aria-selected={i === 0 ? 'true' : 'false'}
            data-model={m.id}
          >{m.tab}</button>
        ))}
      </div>

      <div data-rise style="--i:1">
        <h2 id="hardware-title" class="text-head">Equipos de mostrador</h2>
        {models.map((m, i) => (
          <p class="hw-text mt-8 max-w-[38ch]" data-model={m.id} hidden={i !== 0}>{m.text}</p>
        ))}
      </div>

      <div class="grid gap-2 sm:grid-cols-2" data-rise style="--i:2">
        <a href="#contacto" class="cell bg-ink text-white">Pedir precio de este equipo</a>
        <a href="tel:+34633088505" class="cell bg-surface-2 text-ink">Comercial: 633 088 505</a>
      </div>
    </div>
  </div>
</section>

<style>
  .hw-img { transition: opacity 500ms var(--ease-soft); }
  .hw-tab { color: var(--color-muted); transition: color 200ms ease; }
  .hw-tab[aria-selected='true'] { color: var(--color-ink); font-weight: 600; }
  @media (hover: hover) and (pointer: fine) { .hw-tab:hover { color: var(--color-ink); } }
  .cell {
    display: flex; align-items: center; min-height: 64px; padding: 0 20px;
    font-weight: 500; transition: transform 160ms var(--ease-out), background-color 200ms ease;
  }
  .cell:active { transform: scale(0.98); }
  @media (min-width: 768px) { .cell { min-height: 72px; } }
  @media (hover: hover) and (pointer: fine) {
    .cell.bg-ink:hover { background: var(--color-accent); }
    .cell.bg-surface-2:hover { background: #d6d6d6; }
  }
</style>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('.hw-tab');
  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const id = tab.dataset.model;
      tabs.forEach((t) => t.setAttribute('aria-selected', String(t === tab)));
      document.querySelectorAll<HTMLElement>('.hw-img').forEach((img) => {
        img.style.opacity = img.dataset.model === id ? '1' : '0';
      });
      document.querySelectorAll<HTMLElement>('.hw-text').forEach((p) => {
        p.hidden = p.dataset.model !== id;
      });
    });
  });
</script>
