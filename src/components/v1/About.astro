---
import { Image } from 'astro:assets';
import { zz } from '../../lib/zigzag';
import sirena from '../../assets/la-sirena.jpg';
---

<section id="empresa" class="mt-[clamp(120px,14vw,200px)] px-[var(--m)]" aria-labelledby="empresa-title">
  <div class="panel relative overflow-hidden bg-field text-white">
    <div class="relative z-10 grid gap-12 p-6 pb-0 md:p-14 md:pb-14 lg:grid-cols-[63%_1fr] lg:gap-[var(--g)]">
      <div>
        <h2 id="empresa-title" class="max-w-[14ch] text-head !text-[#f4f4f4]" data-rise>
          Más de 15 años montando barras
        </h2>
        <p class="mt-8 max-w-[36ch] text-lead leading-[1.35] text-white/90" data-rise style="--i:1">
          Somos un equipo joven de Valencia: consultoría, asesoría e instalación de sistemas para hostelería y retail.
        </p>
      </div>

      <div class="flex flex-col gap-12 md:max-w-[60%] lg:max-w-none lg:pt-2">
        <div data-rise style="--i:2">
          <h3 class="text-lead tracking-[-0.02em] !text-white">Servicio técnico oficial</h3>
          <p class="mt-3 max-w-[40ch] leading-[1.55] text-white/90">
            Somos servicio técnico oficial de GLOP, BDP y Firesoft. Instalamos, formamos a tu equipo y
            resolvemos incidencias en persona o en remoto.
          </p>
        </div>
        <div data-rise style="--i:3">
          <h3 class="text-lead tracking-[-0.02em] !text-white">Sin sorpresas en la factura</h3>
          <p class="mt-3 max-w-[40ch] leading-[1.55] text-white/90">
            Te proponemos solo lo que tu negocio necesita, te avisamos de pagos y actualizaciones, y te
            contamos las novedades que de verdad te sirven.
          </p>
        </div>
        <a class="btn self-start" href="tel:+34633748236" data-rise style="--i:4">Llamar al servicio técnico</a>
      </div>
    </div>

    <figure class="photo relative mt-14 md:ml-14 md:w-[60vw] lg:-mt-[8vw] lg:w-[46vw]">
      <div class="zz aspect-[4/3]" style={zz({ top: true, depth: 12, teeth: 30, teethSm: 16 })}>
      <div class="shutter h-full w-full overflow-hidden">
        <Image
          src={sirena}
          alt="Barra del Restaurante La Sirena con el TPV táctil y el cajón de cobro Cashlogy junto a la cafetera"
          widths={[640, 1000, 1400]}
          sizes="(min-width: 1024px) 46vw, (min-width: 768px) 60vw, 100vw"
          class="drift h-full w-full object-cover object-[50%_40%]"
          loading="eager"
        />
      </div>
      </div>
      <figcaption class="absolute bottom-full left-0 mb-3 text-[15px] text-white/80 md:left-auto md:right-[-1rem] md:translate-x-full md:mb-0 md:bottom-[24%] md:w-[18ch]">
        Restaurante La Sirena: TPV y cajón Cashlogy.
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .photo { margin-bottom: -14%; }
  @media (max-width: 767px) {
    .photo { margin-inline: 0; margin-bottom: -20%; display: flex; flex-direction: column-reverse; }
    .photo figcaption { position: static; margin: 0 0 12px; padding-inline: 24px; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .drift { animation: drift 22s ease-in-out infinite alternate; }
    @keyframes drift {
      from { object-position: 50% 30%; scale: 1.04; }
      to { object-position: 50% 50%; scale: 1.1; }
    }
  }
</style>
