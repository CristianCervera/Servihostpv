---
import { Image } from 'astro:assets';
import { zz } from '../../lib/zigzag';
import cashlogy from '../../assets/cashlogy.jpg';
import glory from '../../assets/glory-ci5.png';

const groups = [
  [
    { kind: 'Cashlogy 1500', what: 'El más vendido, para efectivo medio y alto', value: 'desde 8 €/día' },
    { kind: 'Atendido', what: 'El empleado controla el cajón', value: 'Incluido' },
    { kind: 'Desatendido', what: 'El cliente paga directamente', value: 'Incluido' },
    { kind: 'Mixto', what: 'Monedas el cliente, billetes el empleado', value: 'Incluido' },
  ],
  [
    { kind: 'Glory CI-5', what: 'El cajón más pequeño del mercado', value: 'desde 8 €/día' },
    { kind: 'Velocidad', what: 'Billetes por segundo', value: '3' },
    { kind: 'Carga', what: 'Billetes de una vez, en fajo', value: '40' },
  ],
  [
    { kind: 'Compatibles', what: 'Cashkeeper, Cashguard, Azkoyen, Glory', value: 'Con tu TPV' },
    { kind: 'Servicio técnico', what: 'Respuesta en tiempo récord', value: '633 748 236', href: 'tel:+34633748236' },
  ],
];
---

<section id="cajones" class="frame pt-[clamp(120px,14vw,200px)]" aria-labelledby="cajones-title">
  <h2 id="cajones-title" class="max-w-[22ch] text-head" data-rise>
    Cierra la caja en menos de dos minutos
  </h2>

  <div class="grid-12 mt-16 gap-y-12 md:mt-24">
    <div class="col-span-12 flex flex-col gap-8 lg:col-span-5 lg:justify-between">
      <ul class="stub-list max-w-[40ch] space-y-3" data-rise style="--i:1">
        <li>La caja cuadra siempre: cambios exactos y sin descuadres.</li>
        <li>Nadie toca dinero y comida a la vez.</li>
        <li>El efectivo queda a salvo de robos y hurtos.</li>
        <li>Colas más cortas y empleados con tiempo para atender.</li>
      </ul>
      <div class="grid grid-cols-2 gap-2">
        <figure class="zz bg-white" style={zz({ bottom: true, depth: 10, teeth: 14, teethSm: 10 })} data-rise>
          <Image src={cashlogy} alt="Cajón de cobro automático Cashlogy POS 1500 de Azkoyen" widths={[360, 600]} sizes="(min-width: 768px) 20vw, 46vw" class="aspect-[4/5] w-full object-contain p-2" loading="lazy" />
        </figure>
        <figure class="zz bg-white" style={zz({ bottom: true, depth: 10, teeth: 14, teethSm: 10 })} data-rise>
          <Image src={glory} alt="Cajón de cobro automático Glory CashInfinity CI-5" widths={[360, 600]} sizes="(min-width: 768px) 20vw, 46vw" class="aspect-[4/5] w-full object-contain p-2" loading="lazy" />
        </figure>
      </div>
    </div>

    <div class="relative col-span-12 lg:col-span-6 lg:col-start-7 xl:col-span-5 xl:col-start-8">
      <p class="mb-6 hidden text-[15px] xl:absolute xl:-left-[calc(100%/5+var(--g))] xl:top-0 xl:mb-0 xl:block">Cajones</p>
      <table class="w-full text-[1rem]">
        <caption class="sr-only">Cajones de cobro automático y sus características</caption>
        <tbody>
          {groups.map((rows, gi) =>
            rows.map((row, ri) => (
              <tr class={ri === 0 && gi > 0 ? 'group-start' : ''} data-rise style={`--i:${ri}`}>
                <th scope="row" class={`py-[13px] pr-4 text-left align-top ${ri === 0 ? 'font-semibold' : 'font-normal'}`}>{row.kind}</th>
                <td class="py-[13px] pr-4 align-top">{row.what}</td>
                <td class="whitespace-nowrap py-[13px] text-right align-top tabular-nums">
                  {row.href ? <a class="link font-medium text-accent" href={row.href}>{row.value} →</a> : row.value}
                </td>
              </tr>
            )),
          )}
        </tbody>
      </table>
      <a class="btn mt-10" href="#contacto">Pedir información de cajones</a>
    </div>
  </div>
</section>

<style>
  .group-start > * { padding-top: 44px; }
  @media (max-width: 640px) {
    table, tbody { display: block; }
    tr { display: grid; grid-template-columns: 1fr auto; column-gap: 12px; padding: 10px 0; }
    tr.group-start { padding-top: 34px; }
    .group-start > * { padding-top: 0; }
    th, td { padding: 0 !important; }
    th { grid-column: 1; grid-row: 1; }
    td:nth-child(2) { grid-column: 1 / -1; grid-row: 2; }
    td:nth-child(3) { grid-column: 2; grid-row: 1; }
  }
</style>
